# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# FLUXOAPI (WhatsApp Oficial / Meta Cloud API)
# Credenciais oficiais da FluxoAPI (HMAC-SHA256)
FLUXO_KEY=
FLUXO_SECRET=
FLUXO_INSTANCE_ID=
FLUXO_WEBHOOK_SECRET=
FLUXO_PLAN_RPM=60

# APP_PUBLIC_URL: URL pública do Nyroh no deploy da Railway (usada para servir mídias que a Meta baixa)
# Na Railway, se ficar vazia, o domínio público (RAILWAY_PUBLIC_DOMAIN) é usado automaticamente.
APP_PUBLIC_URL=

# FLUXO_WEBHOOK_SECRET: o segredo whsec_… do endpoint de webhook no painel da FluxoAPI.
#   SEM ele o webhook aceita qualquer requisição (o painel /api/infrastructure/status avisa).
# FLUXO_PLAN_RPM: requisições/minuto do SEU plano FluxoAPI (Starter 60, Pro 300, Escala 1200, Enterprise 6000).
# FLUXO_DISPATCH_SHARE: fração do limite que o disparo em massa pode usar (padrão 0.8 = sobra 20% p/ o atendimento).
FLUXO_DISPATCH_SHARE=0.8

# MÍDIA: pasta PERSISTENTE (crie um Volume na Railway). Sem volume, fotos/áudios somem a cada deploy.
#   Se você montar o volume, RAILWAY_VOLUME_MOUNT_PATH é usado automaticamente (UPLOADS_DIR é opcional).
UPLOADS_DIR=
# Só como último recurso: permite mandar mídia por um site público de terceiros (link expira em 72h).
ALLOW_THIRD_PARTY_MEDIA_HOST=false

# CONTAS
# ADMIN_INITIAL_PASSWORD: senha inicial de admin@nyroh.com e thomas@nyroh.com numa instalação NOVA (recomendado).
#   Nunca redefine a senha de quem já existe.
ADMIN_INITIAL_PASSWORD=
# SEED_DEMO_USERS=true cria as contas de demonstração (admin@demo.com/admin123 etc.). NUNCA em produção.
SEED_DEMO_USERS=false

# BANCO: tamanho do pool de conexões do PostgreSQL
PG_POOL_MAX=20

# ESPELHO (opcional, só desenvolvimento): replica no seu computador os eventos da produção.
# Traz telefones/mensagens de clientes reais para a máquina local — use só se souber o que está fazendo.
MIRROR_EVENTS_URL=
MIRROR_EVENTS_TOKEN=

# TESTES: aponta o cliente da FluxoAPI para o mock local (npm run mock:fluxo). Deixe vazio em produção.
FLUXO_BASE_URL=

# META CLOUD API / WHATSAPP OFICIAL
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER=

# BANCO DE DADOS, REDIS & AMBIENTE (Injetados automaticamente pela Railway)
NODE_ENV=production
DATABASE_URL=
REDIS_URL=
PORT=3000

# Provedor de envio: "meta" (direto pela WhatsApp Cloud API) ou "fluxo" (padrão atual)
WHATSAPP_PROVIDER=meta
META_APP_SECRET=
